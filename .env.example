# Server (required)
PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/musically
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ENCRYPT_SECRET_KEY=optional-local-only

# CORS (dev)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Razorpay (required for checkout; get test keys from Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — only needed when testing payment webhooks (Razorpay dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# AWS S3 (required for admin uploads / images / videos — leave empty to browse catalog only)
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email OTP reset (optional in dev)
# For Gmail, use a 16-character App Password, not your normal Gmail password.
EMAIL_USER=
PASSWORD_USER=
